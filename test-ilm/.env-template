# Template only: replace every {...} placeholder before saving a copy as .env.
POSTGRES_USER={PostgreSQL application database username; default: ilmuser}
POSTGRES_PASSWORD={Random PostgreSQL password; generate a unique value with Python secrets.token_urlsafe(32)}
POSTGRES_DB={PostgreSQL application database name; default: ilmdb}
RABBITMQ_ADMIN_USERNAME={RabbitMQ administrator username; default: ilmadmin}
RABBITMQ_ADMIN_PASSWORD={Random RabbitMQ administrator password; generate a unique value with Python secrets.token_urlsafe(32)}
RABBITMQ_PROVISIONER_USERNAME={RabbitMQ provisioner service username; default: ilm-provisioner}
RABBITMQ_PROVISIONER_PASSWORD={Random RabbitMQ provisioner password; generate a unique value with Python secrets.token_urlsafe(32)}
RABBITMQ_PROXY_USERNAME={RabbitMQ proxy service username; default: ilm-proxy}
RABBITMQ_PROXY_PASSWORD={Random RabbitMQ proxy password; generate a unique value with Python secrets.token_urlsafe(32)}
RABBITMQ_CORE_USERNAME={RabbitMQ Core service username; default: ilm-core}
RABBITMQ_CORE_PASSWORD={Random RabbitMQ Core password; generate a unique value with Python secrets.token_urlsafe(32)}
RABBITMQ_TQM_USERNAME={RabbitMQ Time Quality Monitor service username; default: ilm-tqm}
RABBITMQ_TQM_PASSWORD={Random RabbitMQ Time Quality Monitor password; generate a unique value with Python secrets.token_urlsafe(32)}
KEYCLOAK_ADMIN_USERNAME={Keycloak administration username; default: kcadmin}
KEYCLOAK_ADMIN_PASSWORD={Random Keycloak administration password; generate a unique value with Python secrets.token_urlsafe(32)}
ILM_ADMIN_USERNAME={Initial ILM administrator login; default: ilm-admin}
ILM_ADMIN_PASSWORD={Random initial ILM administrator password; generate a unique value with Python secrets.token_urlsafe(32)}
ILM_ADMIN_FIRST_NAME={First name displayed for the initial ILM administrator; default: ILM}
ILM_ADMIN_LAST_NAME={Last name displayed for the initial ILM administrator; default: Administrator}
ILM_ADMIN_EMAIL={Email address for the initial ILM administrator; default: admin@localhost}
OIDC_CLIENT_SECRET={Random secret shared by Core and the Keycloak OIDC client; generate a unique value with Python secrets.token_urlsafe(32)}
